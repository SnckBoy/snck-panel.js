# SNCK Panel (Node.js edition) — example configuration
# Copy to .env and set strong random values. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=6767
SFTP_PORT=6868

# Public origin used for CORS and generated node install commands.
# Leave empty when the panel is reached directly by IP:PORT.
PANEL_URL=
PANEL_ALLOWED_ORIGINS=

# Required secrets (generate with: openssl rand -hex 32)
JWT_SECRET=
NODE_AUTH_SECRET=
NODE_ENCRYPTION_KEY=

# Runtime
DOCKER_SOCKET_PATH=/var/run/docker.sock
NODE_REQUEST_TIMEOUT_MS=10000
NODE_HEARTBEAT_TIMEOUT_MS=45000
DEV_AUTO_LOGIN=false

# Storage (relative paths resolve inside the panel directory)
SNCK_DATA_DIR=.data
SNCK_SERVER_ROOT=/var/lib/snck/servers
SNCK_BACKUP_ROOT=/var/lib/snck/backups
SNCK_UPLOAD_ROOT=/var/lib/snck/uploads
MAX_UPLOAD_BYTES=5368709120

# Rate limiting
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_COMMAND=60
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_WINDOW_MS=60000

# Optional HTTPS certificate paths (when not using a reverse proxy)
PANEL_TLS_KEY=
PANEL_TLS_CERT=

# Optional integrations
MODRINTH_API_BASE=https://api.modrinth.com/v2
PLAYIT_ENABLED=false
CLOUDFLARE_TUNNEL_ENABLED=false
